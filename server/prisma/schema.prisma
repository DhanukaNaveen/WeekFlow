generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEAM_MEMBER
  MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  NEEDS_CORRECTION
  APPROVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum ReviewAction {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role Role @default(TEAM_MEMBER)
  isActive Boolean @default(true)
  reports Report[]
  reviews Review[] @relation("Reviewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())
  name String @unique
  description String?
  isActive Boolean @default(true)
  reports Report[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id String @id @default(cuid())
  userId String
  projectId String
  weekStartDate DateTime @db.Date
  weekEndDate DateTime @db.Date
  status ReportStatus @default(DRAFT)
  notes String?
  links String[] @default([])
  submittedAt DateTime?
  approvedAt DateTime?
  correctionUpdatedAt DateTime?
  user User @relation(fields: [userId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
  tasks ReportTask[]
  nextWeekTasks NextWeekTask[]
  blockers Blocker[]
  achievements Achievement[]
  workHours WorkHour[]
  reviews Review[]
  versions ReportVersion[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, projectId, weekStartDate])
  @@index([status, weekStartDate])
}

model ReportTask {
  id String @id @default(cuid())
  reportId String
  name String
  priority Priority
  plannedPercentage Int
  actualPercentage Int
  status TaskStatus
  plannedTime Float
  actualTime Float
  deliverable String
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model NextWeekTask {
  id String @id @default(cuid())
  reportId String
  name String
  description String?
  priority Priority
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Blocker {
  id String @id @default(cuid())
  reportId String
  title String
  description String
  isKeyIssue Boolean @default(false)
  status BlockerStatus @default(OPEN)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Achievement {
  id String @id @default(cuid())
  reportId String
  title String
  description String
  isKeyAchievement Boolean @default(false)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model WorkHour {
  id String @id @default(cuid())
  reportId String
  workType String
  hours Float
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportVersion {
  id String @id @default(cuid())
  reportId String
  versionNumber Int
  snapshot Json
  submittedAt DateTime @default(now())
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviews Review[]
  @@unique([reportId, versionNumber])
}

model Review {
  id String @id @default(cuid())
  reportId String
  reviewerId String
  versionId String
  action ReviewAction
  comment String?
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id])
  version ReportVersion @relation(fields: [versionId], references: [id])
  createdAt DateTime @default(now())
}

model ActivityLog {
  id String @id @default(cuid())
  actorId String?
  action String
  description String
  createdAt DateTime @default(now())
}
